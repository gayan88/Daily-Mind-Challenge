rules_version = '2';

// v1-pragmatic rules for the guest/registered/admin login system. Real identity comes from
// Firebase Auth (anonymous for guests, email/password for registered accounts) -- there is no
// passwordHash anywhere in Firestore, Firebase Auth owns that entirely. Moderation fields
// (isAdmin/isBanned/bannedReason/bannedDate) can only be changed by an existing admin; everyday
// point writes are capped per-write so a client can't set itself an arbitrary score.
service cloud.firestore {
    match /databases/{database}/documents {

        function isSignedIn() {
            return request.auth != null;
        }

        function isAdmin() {
            return isSignedIn()
                && exists(/databases/$(database)/documents/registeredUsers/$(request.auth.uid))
                && get(/databases/$(database)/documents/registeredUsers/$(request.auth.uid)).data.isAdmin == true;
        }

        match /guests/{uid} {
            allow read: if true;
            allow create: if isSignedIn() && request.auth.uid == uid
                && request.auth.token.firebase.sign_in_provider == 'anonymous';
            allow update: if isSignedIn() && request.auth.uid == uid
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt']);
            allow delete: if false;
        }

        match /registeredUsers/{uid} {
            allow read: if true;
            allow create: if isSignedIn() && request.auth.uid == uid;
            allow update: if isSignedIn() && ((request.auth.uid == uid && isSelfServiceUpdate()) || isAdmin());
            allow delete: if false;

            function isSelfServiceUpdate() {
                let changed = request.resource.data.diff(resource.data).affectedKeys();
                let pointsDelta = request.resource.data.loginPoints - resource.data.loginPoints;
                return changed.hasOnly(['displayName', 'email', 'updatedAt', 'loginPoints', 'lastLoginDate', 'currentStreak'])
                    && pointsDelta >= 0 && pointsDelta <= 100
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() <= 24
                    && request.resource.data.isAdmin == resource.data.isAdmin
                    && request.resource.data.isBanned == resource.data.isBanned
                    && request.resource.data.username == resource.data.username;
            }
        }

        match /usernames/{username} {
            allow read: if true;
            allow create: if isSignedIn() && request.auth.uid == request.resource.data.uid;
            allow update: if false;
            allow delete: if false;
        }

        match /gameScores/{scoreId} {
            allow read: if true;
            allow create: if isSignedIn()
                && request.resource.data.userId == request.auth.uid
                && scoreId == request.auth.uid + '_' + request.resource.data.gameType + '_' + request.resource.data.gameDate
                && request.resource.data.score >= 0 && request.resource.data.score <= maxCreateScore(request.resource.data.gameType);
            // Facebook-share update: the doc owner may add exactly +20 to their own already-created
            // wordle/sudoku/sudoku-classic score, once, in exchange for flipping sharedToFacebook
            // false -> true -- nothing else about the doc is allowed to change. See
            // wordle-daily-data.js#markSharedToFacebook / utils/points.js#markSharedToFacebook.
            allow update: if isAdmin() || isFacebookShareUpdate();
            allow delete: if isAdmin();

            function isFacebookShareUpdate() {
                return isSignedIn() && request.auth.uid == resource.data.userId
                    && resource.data.gameType in ['wordle', 'sudoku', 'sudoku-classic', 'wordsearch', 'wordsearch-classic']
                    && resource.data.sharedToFacebook != true
                    && request.resource.data.sharedToFacebook == true
                    && request.resource.data.score == resource.data.score + 20
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score', 'sharedToFacebook', 'updatedAt']);
            }
        }

        // The Wordle/Sudoku/Word Search Daily Challenge, Classic, and Tournament formulas (before
        // the +20 Facebook share applied separately via update) reach up to 70-100 on create.
        // Tournament completions (see wordle-tournament-data.js / sudoku-tournament-data.js /
        // wordsearch-tournament-data.js) are bounded generously since their inputs (numWords/
        // bonusPoints, or the admin-configured *TournamentSettings) are admin-controlled, not
        // player-controlled -- wordsearch-tournament's ceiling is higher than Sudoku's own
        // tournament ceiling because its per-puzzle completed/failed points are themselves
        // admin-configurable (config/wordsearchTournamentSettings), not hardcoded like Sudoku's.
        // Challenge a Friend plays cap at 30 like the Daily Challenge; the creator's separate
        // +10-per-solver reward falls under the default 10 cap below.
        function maxCreateScore(gameType) {
            return gameType == 'wordle' ? 30
                : gameType == 'wordle-tournament' ? 1000
                : gameType == 'wordle-challenge' ? 30
                : gameType == 'sudoku' ? 100
                : gameType == 'sudoku-classic' ? 100
                : gameType == 'sudoku-tournament' ? 50
                : gameType == 'sudoku-tournament-bonus' ? 2000
                : gameType == 'wordsearch' ? 100
                : gameType == 'wordsearch-classic' ? 100
                : gameType == 'wordsearch-tournament' ? 500
                : gameType == 'wordsearch-tournament-bonus' ? 2000
                : 10;
        }

        // Admin-managed pool of Daily Challenge words -- see src/js/admin/wordle-admin.js.
        // wordleDailyWords/_meta holds { totalCount } alongside the numbered word docs.
        match /wordleDailyWords/{id} {
            allow read: if true;
            allow write: if isAdmin();
        }

        // Admin-managed tournaments (name, words, timePerWordSeconds, bonusPoints, active).
        match /wordleTournaments/{id} {
            allow read: if true;
            allow write: if isAdmin();
        }

        // One progress doc per player per tournament, id = {tournamentId}_{uid}. This only tracks
        // progress (currentWordIndex/wordsWon/completed) -- actual points are granted separately
        // via the guarded gameScores create above, so a client freely writing its own progress
        // here can't award itself points on its own, consistent with this app's existing
        // "v1-pragmatic, not fully cheat-proof" philosophy for self-reported game outcomes.
        match /wordleTournamentAttempts/{attemptId} {
            allow read: if true;
            allow create: if isSignedIn()
                && request.resource.data.uid == request.auth.uid
                && attemptId == request.resource.data.tournamentId + '_' + request.auth.uid
                && request.resource.data.currentWordIndex == 0
                && request.resource.data.wordsWon == 0
                && request.resource.data.completed == false
                && request.resource.data.pointsAwarded == false;
            allow update: if isSignedIn() && request.auth.uid == resource.data.uid
                && request.resource.data.uid == resource.data.uid
                && request.resource.data.tournamentId == resource.data.tournamentId
                && (resource.data.completed == false || request.resource.data.completed == true)
                && (request.resource.data.currentWordIndex == 0
                    || request.resource.data.currentWordIndex == resource.data.currentWordIndex + 1
                    || request.resource.data.currentWordIndex == resource.data.currentWordIndex);
            allow delete: if isAdmin();
        }

        // "Challenge a Friend" -- built into wordle.html (see src/js/games/wordle/wordle-challenge-data.js).
        function canCreateWordleChallenge() {
            return isSignedIn()
                && exists(/databases/$(database)/documents/registeredUsers/$(request.auth.uid))
                && get(/databases/$(database)/documents/registeredUsers/$(request.auth.uid)).data.isBanned == false;
        }

        // Global, continuously-incrementing challenge counter (not per-creator) -- any registered,
        // non-banned user can bump it by exactly 1 when they create a challenge, same bounded-
        // increment shape as the Facebook-share update on gameScores above.
        match /wordleChallenges/_meta {
            allow read: if true;
            allow create: if canCreateWordleChallenge() && request.resource.data.totalCount == 1;
            allow update: if canCreateWordleChallenge()
                && request.resource.data.totalCount == resource.data.totalCount + 1;
        }

        match /wordleChallenges/{challengeId} {
            allow read: if true;
            allow create: if canCreateWordleChallenge() && request.resource.data.creatorUid == request.auth.uid;
            allow update: if false;
            allow delete: if isAdmin();

            match /completions/{uid} {
                allow read: if true;
                allow create: if isSignedIn() && request.auth.uid == uid;
                allow update: if false;
                allow delete: if false;
            }
        }

        match /config/{configId} {
            allow read: if true;
            allow write: if isAdmin();
        }

        // Admin-managed pool of Daily Sudoku puzzles -- see src/js/admin/sudoku-admin.js.
        // sudokuDailyPuzzles/_meta holds { totalCount } alongside the numbered puzzle docs.
        match /sudokuDailyPuzzles/{id} {
            allow read: if true;
            allow write: if isAdmin();
        }

        // Admin-managed pool of Classic Sudoku puzzles -- one global numeric id sequence shared
        // across all three difficulties (difficulty is just a field, not a separate counter).
        match /sudokuClassicPuzzles/{id} {
            allow read: if true;
            allow write: if isAdmin();
        }

        // Admin-managed tournaments -- name + puzzles array only. Time limit / max errors /
        // completion bonus are global (config/sudokuTournamentSettings, covered by the generic
        // config rule above), unlike wordleTournaments which sets time/bonus per tournament.
        match /sudokuTournaments/{id} {
            allow read: if true;
            allow write: if isAdmin();
        }

        // One progress doc per player per tournament, id = {tournamentId}_{uid}, exactly one
        // attempt ever (see sudoku-tournament-data.js). currentPuzzleIndex/puzzlesPassed/
        // puzzlesFailed only ever hold steady or advance by exactly 1 -- unlike
        // wordleTournamentAttempts it never resets, since a failed puzzle here only ends that
        // puzzle, not the run. Actual points are granted separately via the guarded gameScores
        // create above.
        match /sudokuTournamentAttempts/{attemptId} {
            allow read: if true;
            allow create: if isSignedIn()
                && request.resource.data.uid == request.auth.uid
                && attemptId == request.resource.data.tournamentId + '_' + request.auth.uid
                && request.resource.data.currentPuzzleIndex == 0
                && request.resource.data.puzzlesPassed == 0
                && request.resource.data.puzzlesFailed == 0
                && request.resource.data.completed == false
                && request.resource.data.bonusAwarded == false;
            allow update: if isSignedIn() && request.auth.uid == resource.data.uid
                && request.resource.data.uid == resource.data.uid
                && request.resource.data.tournamentId == resource.data.tournamentId
                && (resource.data.completed == false || request.resource.data.completed == true)
                && (request.resource.data.currentPuzzleIndex == resource.data.currentPuzzleIndex
                    || request.resource.data.currentPuzzleIndex == resource.data.currentPuzzleIndex + 1)
                && (request.resource.data.puzzlesPassed == resource.data.puzzlesPassed
                    || request.resource.data.puzzlesPassed == resource.data.puzzlesPassed + 1)
                && (request.resource.data.puzzlesFailed == resource.data.puzzlesFailed
                    || request.resource.data.puzzlesFailed == resource.data.puzzlesFailed + 1);
            allow delete: if isAdmin();
        }

        // Admin-managed pool of Daily Word Search puzzles -- see src/js/admin/wordsearch-admin.js.
        // wordsearchDailyPuzzles/_meta holds { totalCount } alongside the numbered puzzle docs.
        // Puzzle docs hold a word list only ({ theme, words }) -- the grid itself is generated at
        // play time by wordsearch-engine.js, not admin-authored like Sudoku's puzzle+solution pairs.
        match /wordsearchDailyPuzzles/{id} {
            allow read: if true;
            allow write: if isAdmin();
        }

        // Admin-managed pool of Classic Word Search puzzles -- one global numeric id sequence
        // shared across all three difficulties (difficulty is just a field, not a separate counter).
        match /wordsearchClassicPuzzles/{id} {
            allow read: if true;
            allow write: if isAdmin();
        }

        // Admin-managed tournaments -- name + puzzles array (word lists) + completionBonus, set
        // per tournament at creation time. Puzzle count / time limit / completed-puzzle points /
        // failed-puzzle points are global (config/wordsearchTournamentSettings, covered by the
        // generic config rule above) -- unlike wordleTournaments (time/bonus per tournament) and
        // unlike sudokuTournaments (bonus per tournament, but points-per-puzzle hardcoded in code,
        // not configurable at all).
        match /wordsearchTournaments/{id} {
            allow read: if true;
            allow write: if isAdmin();
        }

        // One progress doc per player per tournament, id = {tournamentId}_{uid}, exactly one
        // attempt ever (see wordsearch-tournament-data.js) -- byte-for-byte the same
        // bounded-progression shape as sudokuTournamentAttempts. currentPuzzleIndex/puzzlesPassed/
        // puzzlesFailed only ever hold steady or advance by exactly 1; a failed puzzle here only
        // ends that puzzle, not the run, so nothing ever resets. Actual points are granted
        // separately via the guarded gameScores create above.
        match /wordsearchTournamentAttempts/{attemptId} {
            allow read: if true;
            allow create: if isSignedIn()
                && request.resource.data.uid == request.auth.uid
                && attemptId == request.resource.data.tournamentId + '_' + request.auth.uid
                && request.resource.data.currentPuzzleIndex == 0
                && request.resource.data.puzzlesPassed == 0
                && request.resource.data.puzzlesFailed == 0
                && request.resource.data.completed == false
                && request.resource.data.bonusAwarded == false;
            allow update: if isSignedIn() && request.auth.uid == resource.data.uid
                && request.resource.data.uid == resource.data.uid
                && request.resource.data.tournamentId == resource.data.tournamentId
                && (resource.data.completed == false || request.resource.data.completed == true)
                && (request.resource.data.currentPuzzleIndex == resource.data.currentPuzzleIndex
                    || request.resource.data.currentPuzzleIndex == resource.data.currentPuzzleIndex + 1)
                && (request.resource.data.puzzlesPassed == resource.data.puzzlesPassed
                    || request.resource.data.puzzlesPassed == resource.data.puzzlesPassed + 1)
                && (request.resource.data.puzzlesFailed == resource.data.puzzlesFailed
                    || request.resource.data.puzzlesFailed == resource.data.puzzlesFailed + 1);
            allow delete: if isAdmin();
        }
    }
}
