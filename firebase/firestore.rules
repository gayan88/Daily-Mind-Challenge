rules_version = '2';

// v1-pragmatic rules for the guest/registered/admin login system. Real identity comes from
// Firebase Auth (anonymous for guests, email/password for registered accounts) -- there is no
// passwordHash anywhere in Firestore, Firebase Auth owns that entirely. Moderation fields
// (isAdmin/isBanned/bannedReason/bannedDate) can only be changed by an existing admin; everyday
// point writes are capped per-write so a client can't set itself an arbitrary score.
service cloud.firestore {
    match /databases/{database}/documents {

        function isSignedIn() {
            return request.auth != null;
        }

        function isAdmin() {
            return isSignedIn()
                && exists(/databases/$(database)/documents/registeredUsers/$(request.auth.uid))
                && get(/databases/$(database)/documents/registeredUsers/$(request.auth.uid)).data.isAdmin == true;
        }

        // Registered-only, non-banned gate -- same shape as canCreateWordleChallenge() below, kept
        // as its own generic function since more than one collection needs this exact check
        // (currently playerAchievements; Wordle Challenges keeps its own copy under its own name
        // for now rather than being refactored to share this, to keep this change minimal).
        function isRegisteredNonBanned() {
            return isSignedIn()
                && exists(/databases/$(database)/documents/registeredUsers/$(request.auth.uid))
                && get(/databases/$(database)/documents/registeredUsers/$(request.auth.uid)).data.isBanned == false;
        }

        match /guests/{uid} {
            allow read: if true;
            allow create: if isSignedIn() && request.auth.uid == uid
                && request.auth.token.firebase.sign_in_provider == 'anonymous';
            allow update: if isSignedIn() && request.auth.uid == uid
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt']);
            allow delete: if false;
        }

        match /registeredUsers/{uid} {
            allow read: if true;
            allow create: if isSignedIn() && request.auth.uid == uid;
            allow update: if isSignedIn() && ((request.auth.uid == uid && isSelfServiceUpdate()) || isAdmin());
            allow delete: if false;

            function isSelfServiceUpdate() {
                let changed = request.resource.data.diff(resource.data).affectedKeys();
                let pointsDelta = request.resource.data.loginPoints - resource.data.loginPoints;
                // xp (global, Phase 3 of the progression spec) uses `.get(field, default)` on
                // *both* sides of the delta so this doesn't break for players registered before
                // the `xp` field existed -- a doc with no `xp` key (old side) or a write that
                // doesn't touch `xp` at all (new side) is treated as 0, no migration needed. 300
                // covers the largest single legitimate write: a Daily Mission reward (Phase 7,
                // 100 XP) or the already-decided-but-not-yet-built Weekly Mission reward (300 XP)
                // -- each mission is its own separate write, not summed together, so 300 (not
                // 100+300) is the true ceiling. Comfortably above the smaller writes elsewhere
                // (Daily Challenge completion + perfect-day bonus = 30, a share bonus = 5, login = 5).
                let xpDelta = request.resource.data.get('xp', 0) - resource.data.get('xp', 0);
                // currentStreak (Phase 4) only ever legitimately advances by exactly 1 (a
                // consecutive day) or drops to exactly 1 (a gap, or a first-ever streak day) --
                // same bounded-progression shape as e.g. wordleTournamentAttempts.currentWordIndex
                // below. `lastStreakDate` is a separate field from `lastLoginDate` on purpose --
                // see progression/streak-service.js for why.
                let streakDelta = request.resource.data.get('currentStreak', 0) - resource.data.get('currentStreak', 0);
                return changed.hasOnly(['displayName', 'email', 'updatedAt', 'loginPoints', 'lastLoginDate', 'currentStreak', 'lastStreakDate', 'xp', 'lastPerfectDayDate'])
                    && pointsDelta >= 0 && pointsDelta <= 100
                    && xpDelta >= 0 && xpDelta <= 300
                    && (streakDelta == 0 || streakDelta == 1 || request.resource.data.get('currentStreak', 0) == 1)
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() <= 24
                    && request.resource.data.isAdmin == resource.data.isAdmin
                    && request.resource.data.isBanned == resource.data.isBanned
                    && request.resource.data.username == resource.data.username;
            }
        }

        match /usernames/{username} {
            allow read: if true;
            allow create: if isSignedIn() && request.auth.uid == request.resource.data.uid;
            allow update: if false;
            allow delete: if false;
        }

        match /gameScores/{scoreId} {
            allow read: if true;
            allow create: if isSignedIn()
                && request.resource.data.userId == request.auth.uid
                && scoreId == request.auth.uid + '_' + request.resource.data.gameType + '_' + request.resource.data.gameDate
                && request.resource.data.score >= 0 && request.resource.data.score <= maxCreateScore(request.resource.data.gameType);
            // Share updates: the doc owner may add points to their own already-created score, in
            // exchange for flipping one of two independent share flags false -> true -- nothing
            // else about the doc is allowed to change per update. `sharedToFacebook` (+20, "Copy
            // Result & Share with Community") and `sharedWithFriends` (+10, "Share with Friends",
            // Wordle Daily Challenge only) are separate, stackable bonuses, not alternatives for a
            // single bonus -- a player can claim both, one time each, in two separate update
            // calls. Every other game only ever triggers the +20 path. See
            // wordle-daily-data.js#markSharedToFacebook / #markSharedWithFriends /
            // utils/points.js#markSharedToFacebook.
            allow update: if isAdmin() || isCommunityShareUpdate() || isFriendsShareUpdate();
            allow delete: if isAdmin();

            function isCommunityShareUpdate() {
                return isSignedIn() && request.auth.uid == resource.data.userId
                    && resource.data.gameType in ['wordle', 'wordle-tournament', 'wordle-challenge', 'sudoku', 'sudoku-classic', 'sudoku-tournament-bonus', 'wordsearch', 'wordsearch-classic', 'wordsearch-tournament-bonus']
                    && resource.data.sharedToFacebook != true
                    && request.resource.data.sharedToFacebook == true
                    && request.resource.data.score == resource.data.score + 20
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score', 'sharedToFacebook', 'updatedAt']);
            }

            // "Share with Friends" (+10) is offered by Wordle (Daily Challenge, Tournament,
            // Challenge a Friend), Sudoku (Daily Challenge, Classic, Tournament), and Word Search
            // (Daily Challenge, Classic, Tournament) alike -- each Tournament's bonus lands on its
            // one-time completion-bonus doc, since a tournament run has no single combined score
            // doc to attach it to.
            function isFriendsShareUpdate() {
                return isSignedIn() && request.auth.uid == resource.data.userId
                    && resource.data.gameType in ['wordle', 'wordle-tournament', 'wordle-challenge', 'sudoku', 'sudoku-classic', 'sudoku-tournament-bonus', 'wordsearch', 'wordsearch-classic', 'wordsearch-tournament-bonus']
                    && resource.data.sharedWithFriends != true
                    && request.resource.data.sharedWithFriends == true
                    && request.resource.data.score == resource.data.score + 10
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score', 'sharedWithFriends', 'updatedAt']);
            }
        }

        // The Wordle/Sudoku/Word Search Daily Challenge, Classic, and Tournament formulas (before
        // the +20 Facebook share applied separately via update) reach up to 70-100 on create.
        // Tournament completions (see wordle-tournament-data.js / sudoku-tournament-data.js /
        // wordsearch-tournament-data.js) are bounded generously since their inputs (numWords/
        // bonusPoints, or the admin-configured *TournamentSettings) are admin-controlled, not
        // player-controlled -- wordsearch-tournament's ceiling is higher than Sudoku's own
        // tournament ceiling because its per-puzzle completed/failed points are themselves
        // admin-configurable (config/wordsearchTournamentSettings), not hardcoded like Sudoku's.
        // Challenge a Friend plays cap at 30 like the Daily Challenge; the creator's separate
        // +10-per-solver reward falls under the default 10 cap below.
        function maxCreateScore(gameType) {
            return gameType == 'wordle' ? 30
                : gameType == 'wordle-tournament' ? 1000
                : gameType == 'wordle-challenge' ? 30
                : gameType == 'sudoku' ? 100
                : gameType == 'sudoku-classic' ? 100
                : gameType == 'sudoku-tournament' ? 50
                : gameType == 'sudoku-tournament-bonus' ? 2000
                : gameType == 'wordsearch' ? 100
                : gameType == 'wordsearch-classic' ? 100
                : gameType == 'wordsearch-tournament' ? 500
                : gameType == 'wordsearch-tournament-bonus' ? 2000
                : 10;
        }

        // Admin-managed pool of Daily Challenge words -- see src/js/admin/wordle-admin.js.
        // wordleDailyWords/_meta holds { totalCount, firstDate, lastDate } alongside the word
        // docs, each keyed directly by the "YYYY-MM-DD" date it plays on (not a numeric id).
        match /wordleDailyWords/{id} {
            allow read: if true;
            allow write: if isAdmin();
        }

        // Admin-managed tournaments (name, words, timePerWordSeconds, bonusPoints, active).
        match /wordleTournaments/{id} {
            allow read: if true;
            allow write: if isAdmin();
        }

        // One progress doc per player per tournament, id = {tournamentId}_{uid}. This only tracks
        // progress (currentWordIndex/wordsWon/completed) -- actual points are granted separately
        // via the guarded gameScores create above, so a client freely writing its own progress
        // here can't award itself points on its own, consistent with this app's existing
        // "v1-pragmatic, not fully cheat-proof" philosophy for self-reported game outcomes.
        match /wordleTournamentAttempts/{attemptId} {
            allow read: if true;
            allow create: if isSignedIn()
                && request.resource.data.uid == request.auth.uid
                && attemptId == request.resource.data.tournamentId + '_' + request.auth.uid
                && request.resource.data.currentWordIndex == 0
                && request.resource.data.wordsWon == 0
                && request.resource.data.completed == false
                && request.resource.data.pointsAwarded == false;
            allow update: if isSignedIn() && request.auth.uid == resource.data.uid
                && request.resource.data.uid == resource.data.uid
                && request.resource.data.tournamentId == resource.data.tournamentId
                && (resource.data.completed == false || request.resource.data.completed == true)
                && (request.resource.data.currentWordIndex == 0
                    || request.resource.data.currentWordIndex == resource.data.currentWordIndex + 1
                    || request.resource.data.currentWordIndex == resource.data.currentWordIndex);
            allow delete: if isAdmin();
        }

        // "Challenge a Friend" -- built into wordle.html (see src/js/games/wordle/wordle-challenge-data.js).
        function canCreateWordleChallenge() {
            return isSignedIn()
                && exists(/databases/$(database)/documents/registeredUsers/$(request.auth.uid))
                && get(/databases/$(database)/documents/registeredUsers/$(request.auth.uid)).data.isBanned == false;
        }

        // Global, continuously-incrementing challenge counter (not per-creator) -- any registered,
        // non-banned user can bump it by exactly 1 when they create a challenge, same bounded-
        // increment shape as the Facebook-share update on gameScores above.
        match /wordleChallenges/_meta {
            allow read: if true;
            allow create: if canCreateWordleChallenge() && request.resource.data.totalCount == 1;
            allow update: if canCreateWordleChallenge()
                && request.resource.data.totalCount == resource.data.totalCount + 1;
        }

        match /wordleChallenges/{challengeId} {
            allow read: if true;
            allow create: if canCreateWordleChallenge() && request.resource.data.creatorUid == request.auth.uid;
            allow update: if false;
            allow delete: if isAdmin();

            match /completions/{uid} {
                allow read: if true;
                allow create: if isSignedIn() && request.auth.uid == uid;
                allow update: if false;
                allow delete: if false;
            }
        }

        match /config/{configId} {
            allow read: if true;
            allow write: if isAdmin();
        }

        // Admin-managed pool of Daily Sudoku puzzles -- see src/js/admin/sudoku-admin.js.
        // sudokuDailyPuzzles/_meta holds { totalCount, firstDate, lastDate } alongside the puzzle
        // docs, each keyed directly by the "YYYY-MM-DD" date it plays on (not a numeric id).
        match /sudokuDailyPuzzles/{id} {
            allow read: if true;
            allow write: if isAdmin();
        }

        // Admin-managed pool of Classic Sudoku puzzles -- one global numeric id sequence shared
        // across all three difficulties (difficulty is just a field, not a separate counter).
        match /sudokuClassicPuzzles/{id} {
            allow read: if true;
            allow write: if isAdmin();
        }

        // Admin-managed tournaments -- name + puzzles array only. Time limit / max errors /
        // completion bonus are global (config/sudokuTournamentSettings, covered by the generic
        // config rule above), unlike wordleTournaments which sets time/bonus per tournament.
        match /sudokuTournaments/{id} {
            allow read: if true;
            allow write: if isAdmin();
        }

        // One progress doc per player per tournament, id = {tournamentId}_{uid}, exactly one
        // attempt ever (see sudoku-tournament-data.js). currentPuzzleIndex/puzzlesPassed/
        // puzzlesFailed only ever hold steady or advance by exactly 1 -- unlike
        // wordleTournamentAttempts it never resets, since a failed puzzle here only ends that
        // puzzle, not the run. Actual points are granted separately via the guarded gameScores
        // create above.
        match /sudokuTournamentAttempts/{attemptId} {
            allow read: if true;
            allow create: if isSignedIn()
                && request.resource.data.uid == request.auth.uid
                && attemptId == request.resource.data.tournamentId + '_' + request.auth.uid
                && request.resource.data.currentPuzzleIndex == 0
                && request.resource.data.puzzlesPassed == 0
                && request.resource.data.puzzlesFailed == 0
                && request.resource.data.completed == false
                && request.resource.data.bonusAwarded == false;
            allow update: if isSignedIn() && request.auth.uid == resource.data.uid
                && request.resource.data.uid == resource.data.uid
                && request.resource.data.tournamentId == resource.data.tournamentId
                && (resource.data.completed == false || request.resource.data.completed == true)
                && (request.resource.data.currentPuzzleIndex == resource.data.currentPuzzleIndex
                    || request.resource.data.currentPuzzleIndex == resource.data.currentPuzzleIndex + 1)
                && (request.resource.data.puzzlesPassed == resource.data.puzzlesPassed
                    || request.resource.data.puzzlesPassed == resource.data.puzzlesPassed + 1)
                && (request.resource.data.puzzlesFailed == resource.data.puzzlesFailed
                    || request.resource.data.puzzlesFailed == resource.data.puzzlesFailed + 1);
            allow delete: if isAdmin();
        }

        // Admin-managed pool of Daily Word Search puzzles -- see src/js/admin/wordsearch-admin.js.
        // wordsearchDailyPuzzles/_meta holds { totalCount, firstDate, lastDate } alongside the
        // puzzle docs, each keyed directly by the "YYYY-MM-DD" date it plays on (not a numeric
        // id). Puzzle docs hold a word list only ({ theme, words }) -- the grid itself is
        // generated at play time by wordsearch-engine.js, not admin-authored like Sudoku's
        // puzzle+solution pairs.
        match /wordsearchDailyPuzzles/{id} {
            allow read: if true;
            allow write: if isAdmin();
        }

        // Admin-managed pool of Classic Word Search puzzles -- one global numeric id sequence
        // shared across all three difficulties (difficulty is just a field, not a separate counter).
        match /wordsearchClassicPuzzles/{id} {
            allow read: if true;
            allow write: if isAdmin();
        }

        // Admin-managed tournaments -- name + puzzles array (word lists) + completionBonus, set
        // per tournament at creation time. Puzzle count / time limit / completed-puzzle points /
        // failed-puzzle points are global (config/wordsearchTournamentSettings, covered by the
        // generic config rule above) -- unlike wordleTournaments (time/bonus per tournament) and
        // unlike sudokuTournaments (bonus per tournament, but points-per-puzzle hardcoded in code,
        // not configurable at all).
        match /wordsearchTournaments/{id} {
            allow read: if true;
            allow write: if isAdmin();
        }

        // One progress doc per player per tournament, id = {tournamentId}_{uid}, exactly one
        // attempt ever (see wordsearch-tournament-data.js) -- byte-for-byte the same
        // bounded-progression shape as sudokuTournamentAttempts. currentPuzzleIndex/puzzlesPassed/
        // puzzlesFailed only ever hold steady or advance by exactly 1; a failed puzzle here only
        // ends that puzzle, not the run, so nothing ever resets. Actual points are granted
        // separately via the guarded gameScores create above.
        match /wordsearchTournamentAttempts/{attemptId} {
            allow read: if true;
            allow create: if isSignedIn()
                && request.resource.data.uid == request.auth.uid
                && attemptId == request.resource.data.tournamentId + '_' + request.auth.uid
                && request.resource.data.currentPuzzleIndex == 0
                && request.resource.data.puzzlesPassed == 0
                && request.resource.data.puzzlesFailed == 0
                && request.resource.data.completed == false
                && request.resource.data.bonusAwarded == false;
            allow update: if isSignedIn() && request.auth.uid == resource.data.uid
                && request.resource.data.uid == resource.data.uid
                && request.resource.data.tournamentId == resource.data.tournamentId
                && (resource.data.completed == false || request.resource.data.completed == true)
                && (request.resource.data.currentPuzzleIndex == resource.data.currentPuzzleIndex
                    || request.resource.data.currentPuzzleIndex == resource.data.currentPuzzleIndex + 1)
                && (request.resource.data.puzzlesPassed == resource.data.puzzlesPassed
                    || request.resource.data.puzzlesPassed == resource.data.puzzlesPassed + 1)
                && (request.resource.data.puzzlesFailed == resource.data.puzzlesFailed
                    || request.resource.data.puzzlesFailed == resource.data.puzzlesFailed + 1);
            allow delete: if isAdmin();
        }

        // Player Achievements (Phase 5 of docs/progression-gamification-roadmap.md) -- one doc per
        // earned achievement, id = {uid}_{achievementId}, create-only (same "one attempt" pattern
        // as gameScores/tournament-attempt docs above: a repeat setDoc() on an existing id is an
        // `update`, which no rule here allows, so the achievement-engine.js client code's own
        // pre-filter against already-earned ids is backed up server-side, not just trusted).
        // `count` is always exactly 1 at create time, for every achievement -- Championship
        // achievements (Phase 6, below) still create at count 1 on the *first* win, then use the
        // separate `allow update` block further down to accumulate on repeat wins. The
        // achievementId allow-list must be kept in sync with achievement-registry.js by hand --
        // rules can't import JS -- same maintenance coupling as maxCreateScore()'s gameType list
        // above.
        match /playerAchievements/{achievementDocId} {
            allow read: if true;
            allow create: if isRegisteredNonBanned()
                && request.resource.data.uid == request.auth.uid
                && achievementDocId == request.auth.uid + '_' + request.resource.data.achievementId
                && request.resource.data.achievementId in [
                    'wordle-master', 'sudoku-master', 'wordsearch-master',
                    'streak-7', 'streak-30', 'streak-100', 'streak-365',
                    'explorer-5', 'explorer-10', 'explorer-20',
                    'daily-mind-champion', 'all-rounder', 'puzzle-collector',
                    'wordle-weekly-champion', 'wordle-monthly-champion',
                    'sudoku-weekly-champion', 'sudoku-monthly-champion',
                    'wordsearch-weekly-champion', 'wordsearch-monthly-champion'
                ]
                && request.resource.data.count == 1;

            // Championship achievements (Phase 6) accumulate: every other achievement above is
            // one-time (create-only, no update at all), but a player can win the same weekly/
            // monthly championship repeatedly over time, so `count` may be incremented -- by
            // exactly 1 per update, only by the achievement's own owner, only on a championship id,
            // only touching `count` and nothing else. See progression/championship-service.js#
            // claimChampionshipAchievements().
            allow update: if isSignedIn() && request.auth.uid == resource.data.uid
                && request.resource.data.uid == resource.data.uid
                && request.resource.data.achievementId == resource.data.achievementId
                && resource.data.achievementId in [
                    'wordle-weekly-champion', 'wordle-monthly-champion',
                    'sudoku-weekly-champion', 'sudoku-monthly-champion',
                    'wordsearch-weekly-champion', 'wordsearch-monthly-champion'
                ]
                && request.resource.data.count == resource.data.count + 1
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count']);

            allow delete: if isAdmin();
        }

        // Championships (Phase 6 of docs/progression-gamification-roadmap.md) -- one doc per
        // game+period, id = {gameId}_{periodType}_{periodKey} (matches the exact periodKey format
        // from Section 20 of the spec, e.g. "wordle_week_2026-W36"). Immutable once finalized,
        // except for the one-field `claimed` flip below. Registered, non-banned users only may
        // finalize a period (viewing/reading stays public, `allow read: if true`, so guests can
        // still see who won) -- this doesn't verify the *computed* winner is actually correct
        // (that would need re-running the same aggregation query server-side, which this app has
        // no backend to do), consistent with this app's existing "v1-pragmatic, not fully
        // cheat-proof" points/achievements model. `winnerUid` is null when nobody played that game
        // during the period -- still written (with `claimed: true` immediately, nothing to claim),
        // so the period is marked checked and never re-queried by
        // progression/championship-service.js#finalizeRecentPeriodsIfNeeded().
        match /periodResults/{periodResultId} {
            allow read: if true;
            allow create: if isRegisteredNonBanned()
                && request.resource.data.gameId in ['wordle', 'sudoku', 'wordsearch']
                && request.resource.data.periodType in ['week', 'month']
                && periodResultId == request.resource.data.gameId + '_' + request.resource.data.periodType + '_' + request.resource.data.periodKey
                && (request.resource.data.winnerUid == null || request.resource.data.winnerPoints >= 0);

            // Only the recorded winner may claim their own championship (turn this period's win
            // into a playerAchievements record) -- see claimChampionshipAchievements() above.
            // Nothing else about an already-finalized period can ever change.
            allow update: if isSignedIn() && request.auth.uid == resource.data.winnerUid
                && resource.data.claimed == false
                && request.resource.data.claimed == true
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed']);

            allow delete: if isAdmin();
        }

        // Missions (Phase 7 of docs/progression-gamification-roadmap.md) -- one doc per player per
        // mission per period, id = {uid}_{missionId}_{periodKey}. Daily missions only are
        // implemented so far (`periodKey` is a "YYYY-MM-DD" date); weekly missions, when built,
        // would use an ISO week key like Championships and need their own missionIds added below.
        // Create-only (mirrors gameScores/playerAchievements) -- a repeat setDoc() on an
        // already-claimed mission+period is an `update`, which no rule here allows, so the reward
        // can never be double-awarded even across multiple visits/tabs the same day. `xpAwarded`
        // is bounded generously (covers today's 100-XP daily missions and the
        // already-decided-but-not-yet-built 300-XP weekly reward) rather than validated exactly
        // per missionId, consistent with how loosely this app already trusts self-reported values
        // elsewhere. The missionId allow-list must be kept in sync with
        // progression/mission-service.js by hand -- rules can't import JS -- same maintenance
        // coupling as maxCreateScore()'s gameType list.
        match /playerMissions/{missionDocId} {
            allow read: if true;
            allow create: if isRegisteredNonBanned()
                && request.resource.data.uid == request.auth.uid
                && missionDocId == request.auth.uid + '_' + request.resource.data.missionId + '_' + request.resource.data.periodKey
                && request.resource.data.missionId in [
                    'daily-complete-3-challenges', 'daily-play-3-games', 'daily-earn-1000-points',
                    'daily-wordle-challenge-3-plays', 'daily-share-facebook-group'
                ]
                && request.resource.data.xpAwarded > 0 && request.resource.data.xpAwarded <= 300;
            allow update: if false;
            allow delete: if isAdmin();
        }
    }
}
