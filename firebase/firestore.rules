rules_version = '2';

// v1-pragmatic rules for the guest/registered/admin login system. Real identity comes from
// Firebase Auth (anonymous for guests, email/password for registered accounts) -- there is no
// passwordHash anywhere in Firestore, Firebase Auth owns that entirely. Moderation fields
// (isAdmin/isBanned/bannedReason/bannedDate) can only be changed by an existing admin; everyday
// point writes are capped per-write so a client can't set itself an arbitrary score.
service cloud.firestore {
    match /databases/{database}/documents {

        function isSignedIn() {
            return request.auth != null;
        }

        function isAdmin() {
            return isSignedIn()
                && exists(/databases/$(database)/documents/registeredUsers/$(request.auth.uid))
                && get(/databases/$(database)/documents/registeredUsers/$(request.auth.uid)).data.isAdmin == true;
        }

        match /guests/{uid} {
            allow read: if true;
            allow create: if isSignedIn() && request.auth.uid == uid
                && request.auth.token.firebase.sign_in_provider == 'anonymous';
            allow update: if isSignedIn() && request.auth.uid == uid
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt']);
            allow delete: if false;
        }

        match /registeredUsers/{uid} {
            allow read: if true;
            allow create: if isSignedIn() && request.auth.uid == uid;
            allow update: if isSignedIn() && ((request.auth.uid == uid && isSelfServiceUpdate()) || isAdmin());
            allow delete: if false;

            function isSelfServiceUpdate() {
                let changed = request.resource.data.diff(resource.data).affectedKeys();
                let pointsDelta = request.resource.data.loginPoints - resource.data.loginPoints;
                return changed.hasOnly(['displayName', 'email', 'updatedAt', 'loginPoints', 'lastLoginDate', 'currentStreak'])
                    && pointsDelta >= 0 && pointsDelta <= 100
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() <= 24
                    && request.resource.data.isAdmin == resource.data.isAdmin
                    && request.resource.data.isBanned == resource.data.isBanned
                    && request.resource.data.username == resource.data.username;
            }
        }

        match /usernames/{username} {
            allow read: if true;
            allow create: if isSignedIn() && request.auth.uid == request.resource.data.uid;
            allow update: if false;
            allow delete: if false;
        }

        match /gameScores/{scoreId} {
            allow read: if true;
            allow create: if isSignedIn()
                && request.resource.data.userId == request.auth.uid
                && scoreId == request.auth.uid + '_' + request.resource.data.gameType + '_' + request.resource.data.gameDate
                && request.resource.data.score >= 0 && request.resource.data.score <= 10;
            allow update: if isAdmin();
            allow delete: if isAdmin();
        }

        match /config/{configId} {
            allow read: if true;
            allow write: if isAdmin();
        }

        match /challenges/{challengeId} {
            allow read: if true;
            allow create: if isSignedIn()
                && request.resource.data.creatorUid == request.auth.uid
                && exists(/databases/$(database)/documents/registeredUsers/$(request.auth.uid))
                && get(/databases/$(database)/documents/registeredUsers/$(request.auth.uid)).data.isBanned == false;
            allow update: if false;
            allow delete: if isAdmin();

            match /completions/{uid} {
                allow read: if true;
                allow create: if isSignedIn() && request.auth.uid == uid;
                allow update: if false;
                allow delete: if false;
            }
        }
    }
}
